###Add task
PUT http://localhost:8000/user-api/todo/69315d5495639921c1377c33
Content-Type: application/json

{
    "taskName":"sleeping",
    "description":"I sleep early on this day"

}

###Edit Task

PUT http://localhost:8000/user-api/edit-todo/userid/69315d5495639921c1377c33/taskid/69315d7395639921c1377c36
Content-Type: application/json

{
 "taskName":"sleeping again",
 "description":"I sleep early again",
 "status":"pending"
}


###Set task completed

PUT http://localhost:8000/user-api/edit-status/userid/69315d5495639921c1377c33/taskid/69315d7395639921c1377c36
Content-Type: application/json

{
 "taskName":"sleeping again",
    "description":"I sleep early again",
    "status":"completed"

}

